# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# ---- Database (MySQL) ----
# Create the database first:  CREATE DATABASE giriraj_db;
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/giriraj_db"

# ---- Server ----
PORT=4000
# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Public base URL used to build uploaded-image URLs. Empty = infer from the request.
PUBLIC_URL=

# ---- Admin auth ----
ADMIN_EMAIL=admin@example.com
# Use a long, unique password — prisma/seed.js hashes it with bcrypt.
ADMIN_PASSWORD=

# ---- Leads panel login (separate from the admin panel) ----
# This user can open /leads-panel only — never the site editor at /admin.
# Leave empty to disable the leads panel login entirely.
LEADS_EMAIL=leads@giriraj.com
LEADS_PASSWORD=choose-a-leads-password
# Must be unique and at least 32 characters or the server refuses to start:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Multi-tenant platform ----
# Platform owner login for /super-admin (created by prisma/seed.js).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Client site served on hosts that match no client. Empty = those hosts show the KIT platform
# homepage (production: your own domain). Use ?site=<slug> in the browser to view a client.
DEFAULT_TENANT=
# Every client gets a free subdomain <slug>.PLATFORM_DOMAIN (wildcard DNS *.PLATFORM_DOMAIN -> SERVER_IP).
PLATFORM_DOMAIN=
# Public IP of this server. Clients point their domain's A record here; "Verify DNS" checks against it.
SERVER_IP=
# Claude API key. Set it and new clients get AI-written headlines and copy; empty = template copy with the name swapped.
ANTHROPIC_API_KEY=
# Free photos for new clients: create an app at https://unsplash.com/developers and paste its Access Key.
# Empty = new clients get the template photos re-arranged.
UNSPLASH_ACCESS_KEY=
