# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# ---- Database (MySQL) ----
# Create the database first:  CREATE DATABASE girija_db;
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/girija_db"

# ---- Server ----
PORT=4000
# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Public base URL used to build uploaded-image URLs. Empty = infer from the request.
PUBLIC_URL=

# ---- Admin auth ----
ADMIN_EMAIL=admin@example.com
# Use a long, unique password — prisma/seed.js hashes it with bcrypt.
ADMIN_PASSWORD=

# ---- Leads panel login (separate from the admin panel) ----
# This user can open /leads-panel only — never the site editor at /admin.
# Leave empty to disable the leads panel login entirely.
LEADS_EMAIL=leads@girija.com
LEADS_PASSWORD=choose-a-leads-password
# Must be unique and at least 32 characters or the server refuses to start:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
