# Copy to .env. Vite inlines these at build time, so anything here ends up in the
# shipped bundle — never put a secret in this file.

# Base URL of the Aurelle API, e.g. https://api.example.com/api
# Required: without it the public site cannot read content from the database.
VITE_API_URL=http://localhost:4000/api

# Optional password for the offline demo editor at /admin when no API is configured.
# Leave empty in production.
VITE_ADMIN_DEMO_PASSWORD=
